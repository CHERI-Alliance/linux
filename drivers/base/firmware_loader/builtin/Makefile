obj-y  += main.o

# Create $(fwdir) from $(CONFIG_EXTRA_FIRMWARE_DIR) -- if it doesn't have a
# leading /, it's relative to $(srctree).
fwdir := $(CONFIG_EXTRA_FIRMWARE_DIR)
fwdir := $(addprefix $(srctree)/,$(filter-out /%,$(fwdir)))$(filter /%,$(fwdir))

firmware  := $(addsuffix .gen.o, $(CONFIG_EXTRA_FIRMWARE))
obj-y += $(firmware)

FWNAME    = $(patsubst $(obj)/%.gen.S,%,$@)
FWSTR     = $(subst $(comma),_,$(subst /,_,$(subst .,_,$(subst -,_,$(FWNAME)))))
ASM_WORD  = $(if $(CONFIG_64BIT),.quad,.long)
ASM_PTR   = $(if $(CONFIG_CHERI_KERNEL),.chericap,$(ASM_WORD))
CHERIADD  = $(if $(CONFIG_CHERI_KERNEL),1,0)
ASM_ALIGN = $(if $(CONFIG_64BIT),3+$(CHERIADD),2+$(CHERIADD))
PROGBITS  = $(if $(CONFIG_ARM),%,@)progbits
CHERI_PAD = $(if $(CONFIG_CHERI_KERNEL),$(ASM_WORD) 0,)
# FIXCHERI: Section must be writable for cap relocations
SATTRS    = $(if $(CONFIG_CHERI_KERNEL),aw,a)

filechk_fwbin = \
	echo "/* Generated by $(src)/Makefile */"		;\
	echo "    .section .rodata"				;\
	echo "    .p2align 4"					;\
	echo "_fw_$(FWSTR)_bin:"				;\
	echo "    .incbin \"$(fwdir)/$(FWNAME)\""		;\
	echo "    .size _fw_$(FWSTR)_bin, . - _fw_$(FWSTR)_bin"	;\
	echo "_fw_end:"						;\
	echo "    .section .rodata.str,\"aMS\",$(PROGBITS),1"	;\
	echo "    .p2align $(ASM_ALIGN)"			;\
	echo "_fw_$(FWSTR)_name:"				;\
	echo "    .string \"$(FWNAME)\""			;\
	echo "    .size _fw_$(FWSTR)_name, . - _fw_$(FWSTR)_name";\
	echo "    .section .builtin_fw,\"$(SATTRS)\",$(PROGBITS)";\
	echo "    .p2align $(ASM_ALIGN)"			;\
	echo "    $(ASM_PTR) _fw_$(FWSTR)_name"			;\
	echo "    $(ASM_PTR) _fw_$(FWSTR)_bin"			;\
	echo "    $(ASM_WORD) _fw_end - _fw_$(FWSTR)_bin"	;\
	echo "    $(CHERI_PAD)"

$(obj)/%.gen.S: FORCE
	$(call filechk,fwbin)

# The .o files depend on the binaries directly; the .S files don't.
$(addprefix $(obj)/, $(firmware)): $(obj)/%.gen.o: $(fwdir)/%

targets := $(patsubst $(obj)/%,%, \
                                $(shell find $(obj) -name \*.gen.S 2>/dev/null))
